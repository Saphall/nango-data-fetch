# ── Environments: base URL + bearer token ────────────────────────────────────
# <ENV>_NANGO_BASE_URL / <ENV>_NANGO_BEARER_TOKEN  (ENV: SANDBOX_GLOBAL, SANDBOX_US, DEV, STG, PROD)
SANDBOX_GLOBAL_NANGO_BASE_URL=https://nango.sandbox-global.laudio.io/records
SANDBOX_GLOBAL_NANGO_BEARER_TOKEN=your-bearer-token

SANDBOX_US_NANGO_BASE_URL=https://nango.sandbox-us.laudio.io/records
SANDBOX_US_NANGO_BEARER_TOKEN=

DEV_NANGO_BASE_URL=https://nango.dev.laudio.io/records
DEV_NANGO_BEARER_TOKEN=

STG_NANGO_BASE_URL=https://nango.stg.laudio.io/records
STG_NANGO_BEARER_TOKEN=

PROD_NANGO_BASE_URL=https://nango.prod.laudio.io/records
PROD_NANGO_BEARER_TOKEN=

# ── Clients: connection id + provider config key ─────────────────────────────
# <CLIENT>_NANGO_CONNECTION_ID / <CLIENT>_NANGO_PROVIDER_CONFIG_KEY
# Provider keys: workday, workday-oauth, ukg-pro, ukg-pro-wfm, sharepoint-online-oauth2-cc
GEI1_NANGO_CONNECTION_ID=your-connection-id
GEI1_NANGO_PROVIDER_CONFIG_KEY=workday
